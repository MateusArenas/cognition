// Schema IRMÃO de schema.prisma, só para os testes automatizados (unit com mocks não precisa
// disso; e2e precisa de um banco de verdade por trás do Prisma). Mesmos modelos, provider
// SQLite — não tem Postgres/Docker disponível neste ambiente de teste. Gerado sob demanda
// (`npm run pretest:e2e`, roda antes de `test:e2e` automaticamente) para um `output` separado
// do client de produção — nunca importado pelo código de aplicação em `src/`, só por
// `test/prisma-test-client.ts`. Ver o comentário no topo de schema.prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-test"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  username            String?              @unique
  name                String
  passwordHash        String
  active              Boolean              @default(true)
  roles               UserRole[]
  connections         Connection[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  sshHosts            SshHost[]
  sshCredentials      SshCredential[]
  sshKnownHosts       SshKnownHost[]
  sshSessions         SshSession[]
  sshSnippets         SshSnippet[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now())
}

model Permission {
  id         String   @id @default(uuid())
  action     String
  subject    String
  fields     Json?
  conditions Json?
  inverted   Boolean  @default(false)
  reason     String?
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Connection {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#8E8E93")
  client    String
  config    Json
  readOnly  Boolean  @default(false)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SshHost {
  id              String    @id @default(uuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label           String
  address         String
  port            Int       @default(22)
  username        String
  authMethod      String
  credentialId    String?
  credential      SshCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  groupName       String?
  tags            Json      @default("[]")
  color           String    @default("#8E8E93")
  keepalive       Boolean   @default(true)
  startupCommand  String?
  lastConnectedAt DateTime?
  sessions        SshSession[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SshCredential {
  id                String    @id @default(uuid())
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  kind              String
  keyType           String?
  publicKey         String?
  fingerprintSha256 String?
  hasPassphrase     Boolean   @default(false)
  secretCiphertext  String
  hosts             SshHost[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SshKnownHost {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address           String
  port              Int
  keyType           String
  fingerprintSha256 String
  trustedAt         DateTime @default(now())

  @@unique([ownerId, address, port, keyType])
}

model SshSession {
  id           String    @id @default(uuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hostId       String?
  host         SshHost?  @relation(fields: [hostId], references: [id], onDelete: SetNull)
  status       String
  cols         Int       @default(80)
  rows         Int       @default(24)
  errorMessage String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
}

model SshSnippet {
  id             String   @id @default(uuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  command        String
  tag            String?
  requireConfirm Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
