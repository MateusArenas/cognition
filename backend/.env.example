# Postgres dos dados PRÓPRIOS do backend (usuários, roles, permissões, conexões salvas) — sobe
# com `docker compose up -d` na raiz do monorepo. Nada a ver com os bancos-alvo que o app
# explora: aqueles são configurados pela própria tela de Conexão, dentro do app.
DATABASE_URL="postgresql://dbmobile:dbmobile@localhost:5432/dbmobile?schema=public"

# Assinatura dos tokens JWT emitidos em POST /auth/login. Troque em produção.
JWT_SECRET="troque-isto-em-producao"
JWT_EXPIRES_IN="8h"

# Refresh token — segredo e expiração PRÓPRIOS, nunca os mesmos do access token acima (um
# vazamento de um não pode virar o outro). Ver docs/18-autenticacao.md.
JWT_REFRESH_SECRET="troque-isto-em-producao-tambem"
JWT_REFRESH_EXPIRES_IN="30d"

# Chave usada para cifrar (AES-256-GCM) a senha de cada conexão salva antes de persistir.
APP_SECRET="troque-isto-em-producao"

# SMTP pro e-mail de "esqueci minha senha" — sem SMTP_HOST, MailService cai pro log no console
# (dev-safe, testável de ponta a ponta sem credenciais reais). Configure com um provedor real
# (Gmail com app-password, SendGrid, Resend, Mailtrap etc.) quando quiser e-mail de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DB Mobile <no-reply@dbmobile.local>"

PORT=3333

# npm run db:seed (prisma/seed.ts) cria a primeira role (admin, "manage all") e o primeiro
# usuário — sem isso ninguém consegue nem POST /users, porque essa rota já exige permissão CASL
# de "create User", que ninguém tem até existir um admin. Idempotente (pode rodar de novo sem
# duplicar). Sem estas duas variáveis, usa admin@exemplo.com / troque-esta-senha — troque aqui
# antes de rodar o seed em qualquer ambiente que não seja local só-seu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
