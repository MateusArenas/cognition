# Postgres dos dados PRÓPRIOS do backend (usuários, roles, permissões, conexões salvas) — sobe
# com `docker compose up -d` na raiz do monorepo. Nada a ver com os bancos-alvo que o app
# explora: aqueles são configurados pela própria tela de Conexão, dentro do app.
DATABASE_URL="postgresql://dbmobile:dbmobile@localhost:5432/dbmobile?schema=public"

# Assinatura dos tokens JWT emitidos em POST /auth/login. Troque em produção.
JWT_SECRET="troque-isto-em-producao"
JWT_EXPIRES_IN="8h"

# Chave usada para cifrar (AES-256-GCM) a senha de cada conexão salva antes de persistir.
APP_SECRET="troque-isto-em-producao"

PORT=3333
